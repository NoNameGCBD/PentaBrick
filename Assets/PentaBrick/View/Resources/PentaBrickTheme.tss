@import url("unity-theme://default");

/* 아이콘 버튼은 비활성일 때 더 흐리게 */
.icon-button:disabled { opacity: 0.35; }

/* 버튼 강조. 루트에 .mouse(PC) 또는 .touch(모바일)가 붙는다(GameUI.Start).
   버튼 색은 인라인 스타일이라 여기서 바꿀 수 없어서, 흰 배경 그림을 덮고 그 틴트의 투명도로 밝힌다.
   눌림은 빠르게 들어가고(0.05초) 놓으면 천천히 돌아온다(기본 0.18초). */
Button {
    background-image: resource("ButtonLight");
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-out-cubic;
}
.mouse Button:hover:enabled {
    scale: 1.06 1.06;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.1);
}
Button:active:enabled {
    scale: 0.93 0.93;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.22);
    transition-duration: 0.05s;
}

/* 키보드·게임패드 탐색에서도 현재 버튼을 구분한다. */
Button:focus {
    border-left-color: rgb(97, 216, 232);
    border-right-color: rgb(97, 216, 232);
    border-top-color: rgb(97, 216, 232);
    border-bottom-color: rgb(97, 216, 232);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.15);
}

.game-title { text-shadow: 0 3px 0 rgba(0, 0, 0, 0.5); }
.tactile { transition-property: translate, scale, -unity-background-image-tint-color; transition-duration: 0.13s; }
.mouse .tactile:hover:enabled { translate: 0 -2px; scale: 1.03 1.03; }
.tactile:active:enabled { translate: 0 1px; scale: 0.97 0.97; transition-duration: 0.05s; }
.slot-selected { translate: 0 -2px; }
.arcade-submit { font-size: 17px; }
.mouse .arcade-submit:hover:enabled { scale: 1.05 1.05; }
.blueprint-card { transition-property: scale, -unity-background-image-tint-color; transition-duration: 0.15s; }
